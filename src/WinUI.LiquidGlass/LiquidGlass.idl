    // PasswordBox is sealed in WinUI. Preserve the public control surface through a
    // composable ContentControl that hosts and forwards to the real PasswordBox.
    [webhosthidden] runtimeclass LiquidGlassPasswordBox : Microsoft.UI.Xaml.Controls.ContentControl
    {
        LiquidGlassPasswordBox();
        String PlaceholderText;
        String Password;
        WinUI.Composition.Hlsl.LiquidGlassBrush GlassBrush{ get; };
    }

