    }

    // ToggleSwitch is also sealed. ToggleButton supplies native toggle semantics and is
    // composable; Header/IsOn keep the familiar switch-facing API used by the demo.
    [webhosthidden] runtimeclass LiquidGlassToggleSwitch : Microsoft.UI.Xaml.Controls.Primitives.ToggleButton
    {
        LiquidGlassToggleSwitch();
        Object Header;
        Boolean IsOn;
        WinUI.Composition.Hlsl.LiquidGlassBrush GlassBrush{ get; };
    }
}
