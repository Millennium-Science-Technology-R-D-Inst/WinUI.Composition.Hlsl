<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WinUI.LiquidGlass">

    <Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="local:LiquidGlassToggleSwitch">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="67" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LiquidGlassToggleSwitch">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Spacing="10">
                        <!--
                            The authored knob is 146x92 while the semantic track is 160x67.
                            Keep the public/layout footprint at 160x67, but give Composition
                            22 DIPs of horizontal and 12.5 DIPs of vertical overscan so the
                            .9 pressed scale, rim/refraction and ThemeShadow are never clipped.
                        -->
                        <Grid Width="204" Height="92" Margin="-22,-12.5,-22,-12.5">
                            <!--
                                This is a real 204x92 render host whose negative margin makes its
                                layout contribution exactly 160x67. Unlike the old 160x67 inner
                                host, it does not clip the 146x92 knob when the .9 pressed scale
                                extends beyond the track.
                            -->
                            <Grid x:Name="SwitchGlyph" Width="204" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center" Control.IsTemplateFocusTarget="True">
                                <!-- Composition owns the rendered track color. Center the 160x67 semantic track inside the overscan host. -->
                                <Border x:Name="Track" Width="160" Height="67" Background="Transparent" CornerRadius="33.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!--
                                    Kube's -21.95 authored knob offset becomes approximately zero
                                    here because the track starts 22 DIPs inside this render host.
                                    Composition owns the remaining 0..57.9 DIP drag translation.
                                -->
                                <Grid x:Name="SwitchKnob" Width="146" Height="92" HorizontalAlignment="Left" VerticalAlignment="Center" local:LiquidGlassInteraction.SpringDampingRatio="0.86" local:LiquidGlassInteraction.SpringPeriod="120">
                                    <!--
                                        Kube uses one low-opacity 0 4px 22px outer shadow.
                                        ThemeShadow is an elevation effect with multiple lobes,
                                        which visually reads as another glass shell around this
                                        already-refractive lip surface. Keep the optical body single.
                                    -->
                                    <Border x:Name="SwitchKnobSurface" Background="{TemplateBinding Background}" CornerRadius="46" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver" />
                                <VisualState x:Name="CheckedPressed" />
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>