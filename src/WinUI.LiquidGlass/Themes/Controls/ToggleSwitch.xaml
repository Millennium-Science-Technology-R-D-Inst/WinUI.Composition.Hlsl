<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WinUI.LiquidGlass">

    <Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="local:LiquidGlassToggleSwitch">
        <!--
            Keep Kube's authored geometry at 160x67 internally, but let the standard
            FrameworkElement.Height property scale the entire glyph. A local Height
            therefore overrides this 67-DIP default without rewriting shader geometry.
        -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="67" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LiquidGlassToggleSwitch">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Spacing="10">
                        <!--
                            Keep layout/hit-test semantics at Kube's real 160x67 track size.
                            The 146x92 optical knob is an overflowing Canvas child, exactly like
                            Kube's absolutely-positioned DOM element; Canvas does not use that
                            overflow when measuring the control and does not clip it to the track.
                        -->
                        <Viewbox x:Name="SwitchGlyphViewbox" Height="{TemplateBinding Height}" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="Both">
                            <!--
                                Viewbox scales the complete authored coordinate system as one unit.
                                Shader dimensions, 57.9-DIP travel and lip geometry remain Kube's
                                native values; only the final rendered glyph is uniformly scaled.
                            -->
                            <Grid x:Name="SwitchGlyph" Width="160" Height="67" Control.IsTemplateFocusTarget="True">
                                <Border x:Name="Track" Width="160" Height="67" Background="Transparent" CornerRadius="33.5" />
                                <Canvas Width="160" Height="67" IsHitTestVisible="False">
                                    <!--
                                        Kube:
                                          marginLeft = -THUMB_REST_OFFSET
                                                       + (trackHeight - knobHeight*restScale)/2
                                                     = -21.95
                                          top = trackHeight/2 with translateY(-50%) -> -12.5.
                                        Canvas intentionally permits optical overflow beyond the
                                        160x67 semantic track without contributing it to layout.
                                    -->
                                    <Grid x:Name="SwitchKnob" Width="146" Height="92" Canvas.Left="-21.95" Canvas.Top="-12.5" local:LiquidGlassInteraction.SpringDampingRatio="0.86" local:LiquidGlassInteraction.SpringPeriod="120">
                                        <Border x:Name="SwitchKnobSurface" Background="{TemplateBinding Background}" CornerRadius="46" />
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver" />
                                <VisualState x:Name="CheckedPressed" />
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>