<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LiquidGlassControlsPlatform Condition="'$(Platform)'=='Win32'">x86</LiquidGlassControlsPlatform>
    <LiquidGlassControlsPlatform Condition="'$(LiquidGlassControlsPlatform)'==''">$(Platform)</LiquidGlassControlsPlatform>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.Composition.Hlsl.Controls.winmd">
      <Implementation>WinUI.Composition.Hlsl.Controls.dll</Implementation>
    </Reference>
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(LiquidGlassControlsPlatform)\native\WinUI.Composition.Hlsl.Controls.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.Composition.Hlsl.Controls.pri" />
  </ItemGroup>
</Project>
