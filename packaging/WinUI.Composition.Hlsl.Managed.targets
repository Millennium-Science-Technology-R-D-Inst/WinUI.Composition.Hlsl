<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<HlslCompositionIntermediateRoot Condition="'$(HlslCompositionIntermediateRoot)'==''">$(IntermediateOutputPath)Hlsl\</HlslCompositionIntermediateRoot>
		<HlslCompositionOutputRoot Condition="'$(HlslCompositionOutputRoot)'==''">$(OutputPath)Hlsl\</HlslCompositionOutputRoot>
		<HlslCompositionGenerateHeaders Condition="'$(HlslCompositionGenerateHeaders)'==''">false</HlslCompositionGenerateHeaders>
		<HlslCompositionPublishAsContent Condition="'$(HlslCompositionPublishAsContent)'==''">true</HlslCompositionPublishAsContent>
	</PropertyGroup>
	<ItemGroup>
		<WindowsMetadataReference Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.Composition.Hlsl.winmd" Implementation="WinUI.Composition.Hlsl.dll"/>
	</ItemGroup>
	<Import Project="$(MSBuildThisFileDirectory)WinUI.Composition.Hlsl.Build.targets" />
</Project>
