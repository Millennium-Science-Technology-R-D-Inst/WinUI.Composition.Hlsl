<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WinUILiquidGlassPlatform Condition="'$(Platform)'=='Win32'">x86</WinUILiquidGlassPlatform>
    <WinUILiquidGlassPlatform Condition="'$(WinUILiquidGlassPlatform)'==''">$(Platform)</WinUILiquidGlassPlatform>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.LiquidGlass.winmd">
      <Implementation>WinUI.LiquidGlass.dll</Implementation>
    </Reference>
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-$(WinUILiquidGlassPlatform)\native\WinUI.LiquidGlass.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.LiquidGlass.pri" />
  </ItemGroup>
</Project>
