<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <HlslCompositionCompilerScript Condition="'$(HlslCompositionCompilerScript)'==''">$(MSBuildThisFileDirectory)tools\Compile-HlslCompositionShader.ps1</HlslCompositionCompilerScript>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <HlslCompositionShader>
      <Kind>Auto</Kind>
      <Profile>Pixel40</Profile>
      <Defines></Defines>
      <IncludeDirectories></IncludeDirectories>
      <OutputName></OutputName>
      <HeaderVariableName></HeaderVariableName>
    </HlslCompositionShader>
  </ItemDefinitionGroup>

  <!-- Track every generated artifact that participates in compilation. All imported
       MSBuild project files are inputs because Kind/Profile/OutputName/Defines/include
       metadata can be supplied by Directory.Build.props or other imported files.
       Consumers can list shared .hlsli files as HlslCompositionInclude so include
       changes also invalidate the incremental build. -->
  <ItemGroup>
    <_HlslCompositionTracked Include="@(HlslCompositionShader)">
      <TrackedDxbc Condition="'%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).dxbc</TrackedDxbc>
      <TrackedDxbc Condition="'%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).dxbc</TrackedDxbc>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'=='true' and '%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).g.h</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'=='true' and '%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).g.h</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'!='true' and '%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).dxbc</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'!='true' and '%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).dxbc</TrackedHeader>
      <AssetRelativePath Condition="'%(OutputName)'==''">%(RelativeDir)%(Filename).dxbc</AssetRelativePath>
      <AssetRelativePath Condition="'%(OutputName)'!=''">%(OutputName).dxbc</AssetRelativePath>
    </_HlslCompositionTracked>
  </ItemGroup>

  <Target Name="HlslValidateCompositionShaderMetadata"
          BeforeTargets="HlslCompileCompositionShaders"
          Condition="'@(HlslCompositionShader)'!=''">
    <Error Condition="'%(HlslCompositionShader.Kind)'!='Auto' and '%(HlslCompositionShader.Kind)'!='Color' and '%(HlslCompositionShader.Kind)'!='Sampler' and '%(HlslCompositionShader.Kind)'!='MaterializedSampler'"
           Text="HlslCompositionShader %(HlslCompositionShader.Identity) has invalid Kind '%(HlslCompositionShader.Kind)'. Use Auto, Color, Sampler, or MaterializedSampler." />
    <Error Condition="'%(HlslCompositionShader.Profile)'!='Level91' and '%(HlslCompositionShader.Profile)'!='Level93' and '%(HlslCompositionShader.Profile)'!='Pixel40'"
           Text="HlslCompositionShader %(HlslCompositionShader.Identity) has invalid Profile '%(HlslCompositionShader.Profile)'. Use Level91, Level93, or Pixel40." />
    <Error Condition="!Exists('%(HlslCompositionShader.FullPath)')"
           Text="HlslCompositionShader input does not exist: %(HlslCompositionShader.FullPath)" />
    <Error Condition="!Exists('$(HlslCompositionCompilerScript)')"
           Text="WinUI.Composition.Hlsl build compiler is missing: $(HlslCompositionCompilerScript)" />
  </Target>

  <Target Name="HlslCompileCompositionShaders"
          BeforeTargets="ClCompile;CoreCompile"
          DependsOnTargets="HlslValidateCompositionShaderMetadata"
          Condition="'@(HlslCompositionShader)'!=''"
          Inputs="@(HlslCompositionShader);@(HlslCompositionInclude);$(HlslCompositionCompilerScript);$(MSBuildAllProjects)"
          Outputs="@(_HlslCompositionTracked->'%(TrackedDxbc)');@(_HlslCompositionTracked->'%(TrackedHeader)')">
    <ItemGroup>
      <_HlslCompositionCompile Include="@(_HlslCompositionTracked)">
        <DxbcPath>%(_HlslCompositionTracked.TrackedDxbc)</DxbcPath>
        <HeaderPath>%(_HlslCompositionTracked.TrackedHeader)</HeaderPath>
        <PreparedPath Condition="'%(_HlslCompositionTracked.OutputName)'==''">$(HlslCompositionIntermediateRoot)%(_HlslCompositionTracked.RelativeDir)%(_HlslCompositionTracked.Filename).prepared.hlsl</PreparedPath>
        <PreparedPath Condition="'%(_HlslCompositionTracked.OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(_HlslCompositionTracked.OutputName).prepared.hlsl</PreparedPath>
        <PublishedPath Condition="'%(_HlslCompositionTracked.OutputName)'==''">$(HlslCompositionOutputRoot)%(_HlslCompositionTracked.RelativeDir)%(_HlslCompositionTracked.Filename).dxbc</PublishedPath>
        <PublishedPath Condition="'%(_HlslCompositionTracked.OutputName)'!=''">$(HlslCompositionOutputRoot)%(_HlslCompositionTracked.OutputName).dxbc</PublishedPath>
        <VariableName Condition="'%(_HlslCompositionTracked.HeaderVariableName)'==''">g_%(_HlslCompositionTracked.RelativeDir)%(_HlslCompositionTracked.Filename)_Shader</VariableName>
        <VariableName Condition="'%(_HlslCompositionTracked.HeaderVariableName)'!=''">%(_HlslCompositionTracked.HeaderVariableName)</VariableName>
      </_HlslCompositionCompile>
    </ItemGroup>

    <Exec Condition="'$(HlslCompositionGenerateHeaders)'=='true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(HlslCompositionCompilerScript)&quot; -InputPath &quot;%(_HlslCompositionCompile.FullPath)&quot; -OutputPath &quot;%(_HlslCompositionCompile.DxbcPath)&quot; -Kind &quot;%(_HlslCompositionCompile.Kind)&quot; -Profile &quot;%(_HlslCompositionCompile.Profile)&quot; -IncludeDirectories &quot;%(_HlslCompositionCompile.IncludeDirectories)&quot; -Defines &quot;%(_HlslCompositionCompile.Defines)&quot; -HeaderPath &quot;%(_HlslCompositionCompile.HeaderPath)&quot; -VariableName &quot;%(_HlslCompositionCompile.VariableName)&quot;" />
    <Exec Condition="'$(HlslCompositionGenerateHeaders)'!='true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(HlslCompositionCompilerScript)&quot; -InputPath &quot;%(_HlslCompositionCompile.FullPath)&quot; -OutputPath &quot;%(_HlslCompositionCompile.DxbcPath)&quot; -Kind &quot;%(_HlslCompositionCompile.Kind)&quot; -Profile &quot;%(_HlslCompositionCompile.Profile)&quot; -IncludeDirectories &quot;%(_HlslCompositionCompile.IncludeDirectories)&quot; -Defines &quot;%(_HlslCompositionCompile.Defines)&quot;" />

    <!-- The compiled DXBC is always kept as an intermediate artifact because the
         generated native header is produced from the same FXC invocation and the
         bytecode remains useful for validation/debugging. Publishing it as loose
         application content is a separate policy controlled by the consumer. -->
    <MakeDir Condition="'$(HlslCompositionPublishAsContent)'=='true'"
             Directories="@(_HlslCompositionCompile->'$(HlslCompositionOutputRoot)%(RelativeDir)')" />
    <MakeDir Condition="'$(HlslCompositionPublishAsContent)'=='true' and '%(_HlslCompositionCompile.OutputName)'!=''"
             Directories="$(HlslCompositionOutputRoot)" />
    <Copy Condition="'$(HlslCompositionPublishAsContent)'=='true'"
          SourceFiles="%(_HlslCompositionCompile.DxbcPath)"
          DestinationFiles="%(_HlslCompositionCompile.PublishedPath)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <!-- Intermediate outputs are exposed independently from published assets so
           native consumers can embed .g.h while managed consumers deploy DXBC. -->
      <HlslCompositionShaderBytecodeOutput Include="@(_HlslCompositionCompile->'%(DxbcPath)')" />
      <HlslCompositionShaderHeaderOutput Condition="'$(HlslCompositionGenerateHeaders)'=='true'"
                                         Include="@(_HlslCompositionCompile->'%(HeaderPath)')" />
      <HlslCompositionShaderOutput Condition="'$(HlslCompositionPublishAsContent)'=='true'"
                                   Include="@(_HlslCompositionCompile->'%(PublishedPath)')" />
      <FileWrites Include="@(_HlslCompositionCompile->'%(DxbcPath)')" />
      <FileWrites Include="@(_HlslCompositionCompile->'%(PreparedPath)')" />
      <FileWrites Condition="'$(HlslCompositionPublishAsContent)'=='true'"
                  Include="@(_HlslCompositionCompile->'%(PublishedPath)')" />
      <FileWrites Condition="'$(HlslCompositionGenerateHeaders)'=='true'" Include="@(_HlslCompositionCompile->'%(HeaderPath)')" />
    </ItemGroup>
  </Target>
</Project>
