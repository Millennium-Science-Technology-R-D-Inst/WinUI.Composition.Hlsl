<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <HlslCompositionCompilerScript Condition="'$(HlslCompositionCompilerScript)'==''">$(MSBuildThisFileDirectory)tools\Compile-HlslCompositionShader.ps1</HlslCompositionCompilerScript>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <HlslCompositionShader>
      <Profile>Pixel40</Profile>
    </HlslCompositionShader>
  </ItemDefinitionGroup>

  <!-- Track every generated artifact that participates in compilation. The project
       file itself is an input because Kind/Profile/OutputName/HeaderVariableName
       alter generated bytecode/header content even when the .hlsl timestamp is unchanged. -->
  <ItemGroup>
    <_HlslCompositionTracked Include="@(HlslCompositionShader)">
      <TrackedDxbc Condition="'%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).dxbc</TrackedDxbc>
      <TrackedDxbc Condition="'%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).dxbc</TrackedDxbc>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'=='true' and '%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).g.h</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'=='true' and '%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).g.h</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'!='true' and '%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).dxbc</TrackedHeader>
      <TrackedHeader Condition="'$(HlslCompositionGenerateHeaders)'!='true' and '%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).dxbc</TrackedHeader>
    </_HlslCompositionTracked>
  </ItemGroup>

  <Target Name="HlslValidateCompositionShaderMetadata"
          BeforeTargets="HlslCompileCompositionShaders"
          Condition="'@(HlslCompositionShader)'!=''">
    <Error Condition="'%(HlslCompositionShader.Kind)'!='Color' and '%(HlslCompositionShader.Kind)'!='Sampler' and '%(HlslCompositionShader.Kind)'!='MaterializedSampler'"
           Text="HlslCompositionShader %(Identity) must set Kind to Color, Sampler, or MaterializedSampler." />
    <Error Condition="'%(HlslCompositionShader.Profile)'!='Level91' and '%(HlslCompositionShader.Profile)'!='Level93' and '%(HlslCompositionShader.Profile)'!='Pixel40'"
           Text="HlslCompositionShader %(Identity) has invalid Profile '%(HlslCompositionShader.Profile)'. Use Level91, Level93, or Pixel40." />
    <Error Condition="!Exists('%(HlslCompositionShader.FullPath)')"
           Text="HlslCompositionShader input does not exist: %(HlslCompositionShader.FullPath)" />
    <Error Condition="!Exists('$(HlslCompositionCompilerScript)')"
           Text="WinUI.Composition.Hlsl build compiler is missing: $(HlslCompositionCompilerScript)" />
  </Target>

  <Target Name="HlslCompileCompositionShaders"
          BeforeTargets="ClCompile;CoreCompile"
          DependsOnTargets="HlslValidateCompositionShaderMetadata"
          Condition="'@(HlslCompositionShader)'!=''"
          Inputs="@(HlslCompositionShader);$(HlslCompositionCompilerScript);$(MSBuildProjectFullPath)"
          Outputs="@(_HlslCompositionTracked->'%(TrackedDxbc)');@(_HlslCompositionTracked->'%(TrackedHeader)')">
    <ItemGroup>
      <_HlslCompositionCompile Include="@(_HlslCompositionTracked)">
        <DxbcPath>%(TrackedDxbc)</DxbcPath>
        <HeaderPath>%(TrackedHeader)</HeaderPath>
        <PreparedPath Condition="'%(OutputName)'==''">$(HlslCompositionIntermediateRoot)%(RelativeDir)%(Filename).prepared.hlsl</PreparedPath>
        <PreparedPath Condition="'%(OutputName)'!=''">$(HlslCompositionIntermediateRoot)%(OutputName).prepared.hlsl</PreparedPath>
        <PublishedPath Condition="'%(OutputName)'==''">$(HlslCompositionOutputRoot)%(RelativeDir)%(Filename).dxbc</PublishedPath>
        <PublishedPath Condition="'%(OutputName)'!=''">$(HlslCompositionOutputRoot)%(OutputName).dxbc</PublishedPath>
        <VariableName Condition="'%(HeaderVariableName)'==''">g_%(Filename)_Shader</VariableName>
        <VariableName Condition="'%(HeaderVariableName)'!=''">%(HeaderVariableName)</VariableName>
      </_HlslCompositionCompile>
    </ItemGroup>

    <Exec Condition="'$(HlslCompositionGenerateHeaders)'=='true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(HlslCompositionCompilerScript)&quot; -InputPath &quot;%(_HlslCompositionCompile.FullPath)&quot; -OutputPath &quot;%(_HlslCompositionCompile.DxbcPath)&quot; -Kind &quot;%(_HlslCompositionCompile.Kind)&quot; -Profile &quot;%(_HlslCompositionCompile.Profile)&quot; -HeaderPath &quot;%(_HlslCompositionCompile.HeaderPath)&quot; -VariableName &quot;%(_HlslCompositionCompile.VariableName)&quot;" />
    <Exec Condition="'$(HlslCompositionGenerateHeaders)'!='true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(HlslCompositionCompilerScript)&quot; -InputPath &quot;%(_HlslCompositionCompile.FullPath)&quot; -OutputPath &quot;%(_HlslCompositionCompile.DxbcPath)&quot; -Kind &quot;%(_HlslCompositionCompile.Kind)&quot; -Profile &quot;%(_HlslCompositionCompile.Profile)&quot;" />

    <MakeDir Directories="@(_HlslCompositionCompile->'$(HlslCompositionOutputRoot)%(RelativeDir)')" />
    <MakeDir Condition="'%(_HlslCompositionCompile.OutputName)'!=''" Directories="$(HlslCompositionOutputRoot)" />
    <Copy SourceFiles="%(_HlslCompositionCompile.DxbcPath)"
          DestinationFiles="%(_HlslCompositionCompile.PublishedPath)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <HlslCompositionShaderOutput Include="@(_HlslCompositionCompile->'%(PublishedPath)')" />
      <FileWrites Include="@(_HlslCompositionCompile->'%(DxbcPath)')" />
      <FileWrites Include="@(_HlslCompositionCompile->'%(PreparedPath)')" />
      <FileWrites Include="@(_HlslCompositionCompile->'%(PublishedPath)')" />
      <FileWrites Condition="'$(HlslCompositionGenerateHeaders)'=='true'" Include="@(_HlslCompositionCompile->'%(HeaderPath)')" />
    </ItemGroup>
  </Target>
</Project>
