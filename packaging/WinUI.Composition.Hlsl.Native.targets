<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<HlslNativeArchitecture Condition="'$(Platform)'=='Win32'">x86</HlslNativeArchitecture>
		<HlslNativeArchitecture Condition="'$(HlslNativeArchitecture)'==''">$(Platform)</HlslNativeArchitecture>
		<HlslNativeDll>$(MSBuildThisFileDirectory)..\..\runtimes\win-$(HlslNativeArchitecture)\native\WinUI.Composition.Hlsl.dll</HlslNativeDll>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="$(MSBuildThisFileDirectory)..\..\lib\native\WinUI.Composition.Hlsl.winmd">
			<Implementation>WinUI.Composition.Hlsl.dll</Implementation>
		</Reference>
		<ReferenceCopyLocalPaths Include="$(HlslNativeDll)"/>
	</ItemGroup>
	<ItemGroup Condition="'@(HlslCompositionShader)'!=''">
		<FxCompile Include="@(HlslCompositionShader)">
			<EntryPointName />
			<ShaderType>Library</ShaderType>
			<ShaderModel Condition="'%(HlslCompositionShader.ShaderModel)'==''">4.0</ShaderModel>
			<HeaderFileOutput>$(IntDir)Hlsl\%(Filename).g.h</HeaderFileOutput>
			<ObjectFileOutput>$(IntDir)Hlsl\%(Filename).dxbc</ObjectFileOutput>
			<VariableName>g_%(Filename)_Shader</VariableName>
			<TreatWarningAsError>true</TreatWarningAsError>
			<SuppressStartupBanner>true</SuppressStartupBanner>
			<AdditionalOptions>/Ges /O3 %(AdditionalOptions)</AdditionalOptions>
		</FxCompile>
	</ItemGroup>
	<Target Name="HlslValidateCompositionShaderMetadata" BeforeTargets="PrepareForBuild" Condition="'@(HlslCompositionShader)'!=''">
		<Error Condition="'%(HlslCompositionShader.Kind)'!='Color' and '%(HlslCompositionShader.Kind)'!='Sampler'"
			Text="HlslCompositionShader %(Identity) must set Kind to Color or Sampler."/>
	</Target>
	<Target Name="HlslCheckNativeAsset" BeforeTargets="PrepareForBuild" Condition="!Exists('$(HlslNativeDll)')">
		<Error Text="This WinUI.Composition.Hlsl package does not contain a native binary for $(HlslNativeArchitecture)."/>
	</Target>
</Project>
