<?xml version="1.0"?>
<package>
  <metadata>
    <id>WinUI.Composition.Hlsl</id>
    <version>1.0.0</version>
    <authors>Hoshiizumiya</authors>
    <license type="file">LICENSE.txt</license>
    <description>Native WinRT HLSL composition effects and XAML material brushes for WinUI.</description>
    <readme>README.md</readme>
    <icon>assets\MainLogo.png</icon>
    <dependencies>
      <group targetFramework="native">
        <dependency id="Microsoft.WindowsAppSDK" version="2.4.0"/>
        <dependency id="Microsoft.Windows.CppWinRT" version="2.0.230706.1"/>
      </group>
      <group targetFramework="net8.0-windows10.0.26100.0">
        <dependency id="Microsoft.WindowsAppSDK" version="2.4.0"/>
      </group>
    </dependencies>
    <projectUrl>https://github.com/Millennium-Science-Technology-R-D-Inst/WinUI.Composition.Hlsl</projectUrl>
    <tags>hlsl c++ cpp winui3 winui cpp23 liquid composition shader</tags>
    <repository type="git" url="https://github.com/Millennium-Science-Technology-R-D-Inst/WinUI.Composition.Hlsl"/>
  </metadata>
  <files>
    <!-- Meta -->
    <file src="assets\MainLogo.png" target="assets\"/>
    <file src="README.md" target="README.md"/>
    <file src="LICENSE.txt" target="LICENSE.txt"/>

    <file src="artifacts\x64\Release\WinUI.Composition.Hlsl.winmd" target="lib\native"/>
    <file src="artifacts\x64\Release\WinUI.Composition.Hlsl.dll" target="runtimes\win-x64\native"/>
    <file src="artifacts\Win32\Release\WinUI.Composition.Hlsl.dll" target="runtimes\win-x86\native"/>
    <file src="artifacts\ARM64\Release\WinUI.Composition.Hlsl.dll" target="runtimes\win-arm64\native"/>
    <file src="projection\bin\x64\Release\net8.0-windows10.0.26100.0\WinUI.Composition.Hlsl.Projection.dll" target="lib\net8.0-windows10.0.26100.0"/>

    <file src="packaging\WinUI.Composition.Hlsl.Native.targets" target="buildTransitive\native\WinUI.Composition.Hlsl.targets"/>
    <file src="packaging\WinUI.Composition.Hlsl.Build.targets" target="buildTransitive\native\WinUI.Composition.Hlsl.Build.targets"/>
    <file src="packaging\tools\Compile-HlslCompositionShader.ps1" target="buildTransitive\native\tools\Compile-HlslCompositionShader.ps1"/>

    <file src="packaging\WinUI.Composition.Hlsl.Managed.targets" target="buildTransitive\net8.0-windows10.0.26100.0\WinUI.Composition.Hlsl.targets"/>
    <file src="packaging\WinUI.Composition.Hlsl.Build.targets" target="buildTransitive\net8.0-windows10.0.26100.0\WinUI.Composition.Hlsl.Build.targets"/>
    <file src="packaging\tools\Compile-HlslCompositionShader.ps1" target="buildTransitive\net8.0-windows10.0.26100.0\tools\Compile-HlslCompositionShader.ps1"/>
  </files>
</package>
