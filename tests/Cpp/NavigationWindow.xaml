<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WUILiquidGlassDemo_Hlsl.NavigationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hlsl="using:WinUI.Composition.Hlsl"
    Title="Liquid Glass · Navigation lifetime lab">
    <Grid x:Name="RootGrid" Background="#FF0B1020">
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="80" Canvas.Top="60" Width="260" Height="260" Fill="#FF25C5D9" Opacity="0.85" />
            <Ellipse Canvas.Left="680" Canvas.Top="120" Width="310" Height="310" Fill="#FFE74C7A" Opacity="0.8" />
            <Rectangle Canvas.Left="-160" Canvas.Top="360" Width="1120" Height="64" Fill="#FFF2C94C" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-9" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <NavigationView
            x:Name="RootNavigation"
            Background="{ThemeResource SharedGlassBrush}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Header>
                <Grid Padding="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Navigation lifetime lab" />
                        <TextBlock Opacity="0.72" Text="Shared resource versus per-page brush teardown" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch
                            x:Name="MaterialToggle"
                            Header="Liquid glass"
                            OffContent="Fallback"
                            OnContent="Enabled"
                            Toggled="OnMaterialToggled" />
                        <Button Content="Stress 40 cycles" Click="OnStressClick" />
                    </StackPanel>
                </Grid>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Icon="Home" Tag="overview" />
                <NavigationViewItem Content="Shared brush" Icon="Library" Tag="shared" />
                <NavigationViewItem Content="Isolated brushes" Icon="View" Tag="isolated" />
                <NavigationViewItem Content="Detach / reattach" Icon="Refresh" Tag="detach" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
