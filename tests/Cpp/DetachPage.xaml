<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WUILiquidGlassDemo_Hlsl.DetachPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="900" Spacing="16">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Detach / reattach" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap">This page exercises a real visual-tree detach. After pressing the button, the active subtree is removed and reattached on the next dispatcher turn. Repeat it with the material enabled, then navigate away and back.</TextBlock>
            <ContentControl x:Name="DetachHost">
                <Border Background="{ThemeResource SharedGlassBrush}" CornerRadius="18" Padding="24">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="22" Text="Live subtree" />
                        <TextBlock Text="The shell remains mounted while this content is removed." TextWrapping="Wrap" />
                        <Button Content="Detach then reattach" Click="OnDetachClick" />
                    </StackPanel>
                </Border>
            </ContentControl>
            <TextBlock x:Name="StatusText" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</Page>
