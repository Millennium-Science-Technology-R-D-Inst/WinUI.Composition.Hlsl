<Window
    x:Class="HlslCSharpConsumer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hlsl="using:WinUI.Composition.Hlsl"
    Title="WinUI.Composition.Hlsl · C# sample">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <hlsl:LiquidGlassBrush x:Key="GlassBrush" BlurRadius="10" RefractionStrength="18" DispersionStrength="1.2" CornerRadius="28" BorderThickness="1" HighlightStrength="0.8" FallbackColor="#CCFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <hlsl:LiquidGlassBrush x:Key="GlassBrush" BlurRadius="10" RefractionStrength="18" DispersionStrength="1.2" CornerRadius="28" BorderThickness="1" HighlightStrength="0.8" FallbackColor="#CC202020" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="320" Height="320" Canvas.Left="100" Canvas.Top="80" Fill="#FF41D1FF" />
            <Ellipse Width="260" Height="260" Canvas.Left="520" Canvas.Top="250" Fill="#FFFF5F8A" />
            <Rectangle Width="720" Height="100" Canvas.Left="40" Canvas.Top="360" Fill="#FFFFC84A" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><RotateTransform Angle="-12" /></Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <StackPanel Width="260" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="8">
            <TextBlock Text="C# WinUI 3 sample" Style="{ThemeResource TitleTextBlockStyle}" />
            <ComboBox x:Name="ThemeSelector" Header="Color theme" SelectedIndex="0" SelectionChanged="OnThemeChanged">
                <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
            </ComboBox>
            <ToggleSwitch x:Name="MaterialSwitch" Header="Liquid glass" IsOn="True" Toggled="OnMaterialToggled" />
            <TextBlock Text="Blur radius" />
            <Slider x:Name="BlurSlider" Minimum="0" Maximum="64" Value="10" ValueChanged="OnMaterialValueChanged" />
            <TextBlock Text="Refraction" />
            <Slider x:Name="RefractionSlider" Minimum="0" Maximum="128" Value="18" ValueChanged="OnMaterialValueChanged" />
            <TextBlock Text="Dispersion" />
            <Slider x:Name="DispersionSlider" Minimum="0" Maximum="16" Value="1.2" ValueChanged="OnMaterialValueChanged" />
            <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
        </StackPanel>
        <Border x:Name="GlassPanel" Width="460" Height="280" Margin="0,0,100,50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{ThemeResource GlassBrush}" CornerRadius="28" Padding="32">
            <StackPanel VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Liquid Glass" FontSize="36" FontWeight="SemiBold" />
                <TextBlock Text="This panel uses the native WinRT component through one NuGet PackageReference." TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
