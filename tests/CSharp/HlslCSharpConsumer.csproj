<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
		<UseWinUI>true</UseWinUI>
		<WindowsPackageType>None</WindowsPackageType>
		<Platforms>x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>HlslCSharpConsumer</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- This project sits above another managed test project. Keep SDK default
		     item globs from recursively compiling or packaging the child project. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);LiquidGlassConsumer\**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK"/>
		<PackageReference Include="WinUI.Composition.Hlsl"/>
	</ItemGroup>
	<ItemGroup>
		<!-- Kind=Auto and Profile=Pixel40 are the package defaults. This consumer
		     intentionally omits both so CI exercises automatic contract inference. -->
		<HlslCompositionShader Include="ConsumerColor.hlsl">
			<Defines>WINUI_COMPOSITION_MANAGED_TEST=1</Defines>
		</HlslCompositionShader>
		<HlslCompositionShader Include="ConsumerMaterializedSampler.hlsl">
			<Kind>MaterializedSampler</Kind>
			<Profile>Pixel40</Profile>
		</HlslCompositionShader>
		<!-- Multi-source managed fixtures exercise the packaged SourceCount metadata
		     and Auto kind inference without project-specific build integration. -->
		<HlslCompositionShader Include="ConsumerMultiSourceColor.hlsl">
			<SourceCount>2</SourceCount>
		</HlslCompositionShader>
		<HlslCompositionShader Include="ConsumerMultiSourceSampler.hlsl">
			<SourceCount>2</SourceCount>
		</HlslCompositionShader>
	</ItemGroup>
	<ItemGroup>
		<Manifest Include="app.manifest" />
	</ItemGroup>
</Project>
