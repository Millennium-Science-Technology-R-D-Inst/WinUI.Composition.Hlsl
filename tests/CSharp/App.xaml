<Application x:Class="HlslCSharpConsumer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlsl="using:WinUI.Composition.Hlsl">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
			</ResourceDictionary.MergedDictionaries>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<hlsl:LiquidGlassBrush x:Key="TestBrush" IsEnabled="False" BlurRadius="10" RefractionStrength="16" FallbackColor="White"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<hlsl:LiquidGlassBrush x:Key="TestBrush" IsEnabled="False" BlurRadius="16" RefractionStrength="10" FallbackColor="#202020"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="HighContrast">
					<SolidColorBrush x:Key="TestBrush" Color="{ThemeResource SystemColorWindowColor}"/>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>